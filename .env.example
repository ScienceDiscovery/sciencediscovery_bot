# Copy to .env (git-ignored). Values are read by docker compose; for host mode `set -a; . ./.env; set +a`.

# Webhook secrets: GitHub App "Webhook secret" or organization/repository webhook "Secret", and GitCode
# webhook "签名密钥 / 密码" fields. SDBOT_WEBHOOK_SECRET is a fallback used for both providers.
# GitHub App and ordinary webhooks share /webhook/github and this one secret per instance.
SDBOT_GITHUB_WEBHOOK_SECRET=
SDBOT_GITCODE_WEBHOOK_SECRET=
#SDBOT_WEBHOOK_SECRET=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > Create a tunnel > Docker: the value after --token).
# The tunnel's public hostname must point at  http://bot:8791  (webhook listener). Never route bot:8792.
CLOUDFLARE_TUNNEL_TOKEN=
# Enable only after setting a real token; the default starts the bot alone.
#COMPOSE_PROFILES=tunnel

# Only these GitHub repositories trigger hooks. Every other webhook is still archived.
SDBOT_REPOS=openJiuwen-ai/sciencediscovery,ScienceDiscovery/sciencediscovery

# Optional: require  Authorization: Bearer <token>  on admin data/replay endpoints (the static panel shell can load first).
#SDBOT_ADMIN_TOKEN=

# Host-side ports (compose publishes both on 127.0.0.1 only).
#SDBOT_WEBHOOK_PORT=8791
#SDBOT_ADMIN_PORT=8792
#SDBOT_LOG_LEVEL=INFO
# Every webhook attempt is archived. Bodies above this limit retain only the received prefix.
#SDBOT_MAX_BODY_MB=25

# Optional static GitHub Pages board (docker-compose.board.yml).
# Use the installed GitHub App; never commit its private key.
#SDBOT_BOARD_TARGETS='{"openJiuwen-ai/sciencediscovery":"ScienceDiscovery/github-status-board","ScienceDiscovery/sciencediscovery":"ScienceDiscovery/github-status-board-test"}'
#SDBOT_BOARD_SOURCE_DIR_HOST=../github_status_board
#SDBOT_BOARD_EXECUTION=github_actions
#SDBOT_GITHUB_APP_ID=
#SDBOT_GITHUB_APP_PRIVATE_KEY=
# PEM supports literal \n newlines inside a single-quoted .env value.
# Legacy token alternative (mutually exclusive with App credentials):
#SDBOT_BOARD_GITHUB_TOKEN=
#SDBOT_BOARD_DEBOUNCE=20
#SDBOT_BOARD_REFRESH=3600
