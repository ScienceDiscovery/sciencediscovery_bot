{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sciencediscovery-bot",
  "main": "src/worker/index.ts",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "version_metadata": { "binding": "SDBOT_VERSION" },
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sciencediscovery-bot-worker.llmbots.co", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "BotObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotObject"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "sciencediscovery-bot-archive" }],
  // Production dispatches collection to the formal dashboard only.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "SDBOT_ENVIRONMENT": "production",
    "SDBOT_ACTIONS_AUDIENCE": "sdbot:actions:production",
    "SDBOT_ACTIONS_REPOSITORY_ID": "1379305235",
    "SDBOT_ACTIONS_OWNER_ID": "329935216",
    "SDBOT_ADMIN_HOSTNAME": "sciencediscovery-bot-worker.llmbots.co",
    "SDBOT_GITHUB_APP_ID": "5016872",
    "SDBOT_REPOS": "openJiuwen-ai/sciencediscovery",
    "SDBOT_BOARD_TARGETS": "{\"openJiuwen-ai/sciencediscovery\":\"ScienceDiscovery/github-status-board\"}",
    // Events within ten minutes share one collection: a busy source repository
    // otherwise starts a collection and a Pages deployment for nearly every event.
    "SDBOT_BOARD_DEBOUNCE": "600"
  },
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
