{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sciencediscovery-bot-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-30",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "version_metadata": { "binding": "SDBOT_VERSION" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sciencediscovery-bot-test.llmbots.co", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "BOT", "class_name": "BotObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotObject"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "sciencediscovery-bot-test-archive" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // Account analytics for the admin usage section; the read-only token is the SDBOT_ANALYTICS_TOKEN secret.
    "SDBOT_CLOUDFLARE_ACCOUNT_ID": "bca0917f4ae3bc29439e2e5007abd5a9",
    "SDBOT_ARCHIVE_BUCKET": "sciencediscovery-bot-test-archive",
    "SDBOT_ENVIRONMENT": "test",
    "SDBOT_ACTIONS_AUDIENCE": "sdbot:actions:test",
    "SDBOT_ACTIONS_REPOSITORY_ID": "1380779676",
    "SDBOT_ACTIONS_OWNER_ID": "329935216",
    "SDBOT_GITHUB_APP_ID": "5041384",
    "SDBOT_ADMIN_HOSTNAME": "sciencediscovery-bot-test.llmbots.co",
    "SDBOT_REPOS": "ScienceDiscovery/sciencediscovery",
    "SDBOT_BOARD_TARGETS": "{\"ScienceDiscovery/sciencediscovery\":\"ScienceDiscovery/github-status-board-test\"}",
    // The GitCode target defaults to the production mirror; the test instance must never sync there.
    "SDBOT_GITCODE_SYNC_TARGET": "off"
  },
  "observability": { "logs": { "enabled": true, "invocation_logs": true } }
}
